# Copy this file to .env and fill in the values for each deployment.

# ── API ───────────────────────────────────────────────────────────────────
VITE_API_URL=https://your-api.example.com/api/v1/

# ── Brand / white-label ───────────────────────────────────────────────────
# These values appear in the browser tab, sidebar, login footer and receipts.
VITE_APP_NAME=Kamex Solutions
VITE_APP_TAGLINE=Sistema de gestión de inventario
VITE_COMPANY_NAME=Mi Negocio
VITE_SUPPORT_EMAIL=soporte@example.com

# ── Logo ──────────────────────────────────────────────────────────────────
# Rutas dentro de public/ (el archivo tiene que existir ahí de verdad, esto
# solo apunta a él). Si se dejan vacías, usa el logo de Kamex por defecto.
# Ver clients/README.md para el flujo completo de armar el build de un
# cliente puntual con su propio logo.
VITE_LOGO_URL=/img/kamex_negro.png
VITE_LOGO_URL_DARK=/img/kamex_blanco.png

# ── Brand colours ─────────────────────────────────────────────────────────
# Must be valid CSS hex values, IN QUOTES — without quotes, dotenv treats the
# leading "#" as a comment and the value silently becomes empty (falls back
# to the default in config/brand.js with no error).  Applied at build time —
# one build per client/deployment.
VITE_PRIMARY_COLOR="#B0653D"
VITE_PRIMARY_HOVER="#985635"

# ── Feature flags ─────────────────────────────────────────────────────────
# Cobrar con Point (lector de tarjeta Mercado Pago) deshabilitado temporalmente
# a pedido — no afecta a QR. Poner en true para reactivarlo (y también
# POINT_HABILITADO=true en el .env del backend).
VITE_POINT_HABILITADO=false

# Modo demo: simula un usuario admin con todos los permisos y no llama al
# backend real (útil para demos de venta). Dejar en false en producción real.
VITE_DEMO_MODE=false

# Catálogo online (página pública con los productos, sin login) — apagado a
# menos que ESTE cliente puntual lo pida. Ejemplo de referencia para
# "módulo opcional por cliente": no hace falta tocar código, solo esta
# variable en el .env de ese build (ver clients/README.md).
VITE_CATALOGO_HABILITADO=false

# ── Monitoreo de errores ──────────────────────────────────────────────────
# DSN de Sentry. Si se deja vacío, Sentry queda desactivado (no-op) — ok para
# desarrollo local, pero en producción conviene tener uno cargado.
VITE_SENTRY_DSN=
