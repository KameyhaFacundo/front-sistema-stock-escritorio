# Copiar esta carpeta a clients/<nombre-cliente>/ y completar acá abajo.
# Ver clients/README.md para el flujo completo.

# ── API ───────────────────────────────────────────────────────────────────
VITE_API_URL=https://tu-api-de-este-cliente.example.com/api/v1/

# ── Brand / white-label ───────────────────────────────────────────────────
VITE_APP_NAME=Nombre del sistema para este cliente
VITE_APP_TAGLINE=Eslogan corto
VITE_COMPANY_NAME=Nombre del negocio del cliente
VITE_SUPPORT_EMAIL=soporte@example.com

# ── Logo ──────────────────────────────────────────────────────────────────
# Poner los archivos reales en clients/<nombre-cliente>/logo/ con estos
# mismos nombres — el paso 2 del README los copia a public/img/.
VITE_LOGO_URL=/img/logo-negro.png
VITE_LOGO_URL_DARK=/img/logo-blanco.png

# ── Brand colours ─────────────────────────────────────────────────────────
# Deben ir entre comillas — sin comillas, dotenv trata el "#" como comentario
# y el valor queda vacío en silencio (cae al color por defecto sin avisar).
VITE_PRIMARY_COLOR="#5c6ef8"
VITE_PRIMARY_HOVER="#4a5cf0"

# ── Feature flags ─────────────────────────────────────────────────────────
VITE_POINT_HABILITADO=false
VITE_DEMO_MODE=false

# ── Monitoreo de errores ──────────────────────────────────────────────────
VITE_SENTRY_DSN=
